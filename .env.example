# VeriCode is local-first and keyless. These are optional tunables only.

# Path to a custom CA bundle for OSV requests (leave empty to use system default)
VERICODE_CA_BUNDLE=

# Request timeout (seconds) for the OSV API
VERICODE_OSV_TIMEOUT=20

# Comma-separated relative paths always excluded from scanning
VERICODE_EXCLUDE=tests,node_modules
